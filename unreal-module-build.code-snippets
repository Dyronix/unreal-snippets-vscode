{
	"unreal-module-build": {
		"scope": "csharp",
		"prefix": "umb",
		"body": [
			"using UnrealBuildTool;",
			"",
			"public class ${TM_FILENAME/([^\\.]+)\\..*/$1/} : ModuleRules",
			"{",
			"\tpublic ${TM_FILENAME/([^\\.]+)\\..*/$1/}(ReadOnlyTargetRules Target) : base(Target)",
			"\t{",
			"\t\tPCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;",
			"",
			"\t\tPublicDependencyModuleNames.AddRange(new string[] { \"Core\", \"CoreUObject\", \"Engine\", \"InputCore\", \"EnhancedInput\" });",
			"",
			"\t\tPrivateDependencyModuleNames.AddRange(new string[] { $1 });",
			"",
			"\t\t// Uncomment if you are using Slate UI",
			"\t\t// PrivateDependencyModuleNames.AddRange(new string[] { \"Slate\", \"SlateCore\" });",
			"",
			"\t\t// Uncomment if you are using online features",
			"\t\t// PrivateDependencyModuleNames.Add(\"OnlineSubsystem\");",
			"\t}",
			"}"
		],
		"description": "unreal-module-build"
	}
}
