			"\t}",
			"",
			"\tstatic inline bool IsAvailable()",
			"\t{",
			"\t\treturn FModuleManager::Get().IsModuleLoaded(\"${TM_FILENAME/([^\\.]+)\\..*/$1/}\");",
			"\t}",
			"",
			"\tvirtual void StartupModule() override;",
			"\tvirtual void ShutdownModule() override;",
			"};"
